# {{ project_title }}'s environment. Copy to `.env` and fill in what your
# deployment needs.
#
# The four feature apps -- cms, notifications, shop and support -- ship OFF, and
# the *_ENABLED flags below are the whole switch. An app that is not named
# installs nothing, migrates nothing, publishes no routes and never imports its
# package, so turning one on is the only thing you have to do to get it, and
# leaving it off costs you nothing. Turn one on and run `manage.py migrate`.
#
DJANGO_SETTINGS_MODULE=config.settings.development
# Every app you turn on brings a settings contract, and `config/wsgi.py` and
# `config/asgi.py` check it before serving a request: a deployment that enabled
# an app and left one of its settings empty or out of range is refused at boot,
# with the same report `manage.py check` prints. Set this to serve anyway.
# DJANGO_SKIP_PREFLIGHT=false
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_OAUTH_MODE=none
DJANGO_OAUTH_PROVIDERS=
DJANGO_OAUTH_ENCRYPTION_KEY=
DJANGO_OAUTH_AUTO_CREATE_USERS=true
DJANGO_OAUTH_STORE_PROVIDER_TOKENS=false
DJANGO_OAUTH_LOGIN_REDIRECT_URL=/
DJANGO_OAUTH_CLOCK_SKEW_SECONDS=60
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
DJANGO_AUTH_METHODS=
DJANGO_AUTH_SECOND_FACTORS=
DJANGO_AUTH_TOKEN_MODE=
DJANGO_AUTH_SESSION_TOKEN_FOR_STAFF=true
DJANGO_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_AUTH_CHALLENGE_STORE=infrastructure.auth.core.challenges.RedisChallengeStore
DJANGO_AUTH_CHALLENGE_TTL_SECONDS=300
DJANGO_AUTH_CHALLENGE_MAX_ATTEMPTS=5
DJANGO_AUTH_PENDING_LOGIN_TTL_SECONDS=600
DJANGO_AUTH_CODE_DIGITS=6
DJANGO_AUTH_RESEND_COOLDOWN_SECONDS=30
DJANGO_AUTH_MAX_SENDS_PER_HOUR=10
DJANGO_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
DJANGO_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
DJANGO_AUTH_SLIDING_IDLE_TIMEOUT_SECONDS=900
DJANGO_AUTH_SMS_BACKEND=infrastructure.auth.core.delivery.ConsoleSmsBackend
DJANGO_AUTH_EMAIL_BACKEND=infrastructure.auth.core.delivery.DjangoEmailBackend
DJANGO_AUTH_EMAIL_FROM=no-reply@example.com
DJANGO_AUTH_SMS_FROM=
DJANGO_AUTH_MAGIC_LINK_BASE_URL=
DJANGO_AUTH_PASSWORD_RESET_BASE_URL=
DJANGO_AUTH_AUTO_CREATE_USERS=true
DJANGO_AUTH_TOTP_ISSUER={{ project_title }}
DJANGO_AUTH_RECOVERY_CODE_COUNT=10
DJANGO_AUTH_JWT_ALGORITHM=HS256
DJANGO_AUTH_JWT_SIGNING_KEY=
DJANGO_AUTH_JWT_VERIFYING_KEY=
DJANGO_AUTH_JWT_ISSUER={{ project_name }}
DJANGO_AUTH_JWT_AUDIENCE=
DJANGO_AUTH_JWT_LEEWAY_SECONDS=30
DJANGO_CMS_ENABLED=false
# Which transports this app publishes. Unset serves every one it speaks, which
# is what this sample wants; a deployment whose clients only call one can narrow
# it -- `rest,ws` serves the endpoints and the socket and publishes neither the
# GraphQL fields nor the gRPC services. A name the app does not speak is refused
# at startup rather than ignored.
# DJANGO_CMS_TRANSPORTS=rest,graph,grpc
DJANGO_CMS_LANGUAGES=en-us
DJANGO_CMS_PREVIEW_TTL_SECONDS=86400
DJANGO_CMS_UPLOAD_PATH=cms/uploads
DJANGO_CMS_MAX_UPLOAD_MB=20
# Where uploaded files are written and the address they are served under. Both
# are unused by a project that points STORAGES at a bucket instead.
DJANGO_MEDIA_URL=media/
DJANGO_MEDIA_ROOT=
DJANGO_NOTIFICATIONS_ENABLED=false
# DJANGO_NOTIFICATIONS_TRANSPORTS=rest,graph,grpc,ws
DJANGO_NOTIFICATIONS_WS_PATH=/ws/notifications
DJANGO_NOTIFICATIONS_BROKER=apps.notifications.broadcast.MemoryBroker
DJANGO_NOTIFICATIONS_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_NOTIFICATIONS_CHANNEL_PREFIX=notifications
DJANGO_NOTIFICATIONS_SOCKET_BACKLOG=20
# Zero keeps everything. Set a window and schedule
# `manage.py notifications_prune`; nothing deletes anything until you run it.
DJANGO_NOTIFICATIONS_RETENTION_DAYS=0
DJANGO_SUPPORT_ENABLED=false
# DJANGO_SUPPORT_TRANSPORTS=rest,graph,grpc,ws
DJANGO_SUPPORT_WS_PATH=/ws/support
DJANGO_SUPPORT_BROKER=apps.support.broadcast.MemoryBroker
DJANGO_SUPPORT_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SUPPORT_CHANNEL_PREFIX=support
DJANGO_SUPPORT_REFERENCE_PREFIX=SUP
DJANGO_SUPPORT_SOCKET_BACKLOG=30
# A prefix inside STORAGES["default"], not a filesystem path: a folder under
# MEDIA_ROOT locally, a key prefix in a bucket in production.
DJANGO_SUPPORT_UPLOAD_PATH=support/uploads
# The largest attachment anybody may send. Zero means no limit here, for a
# deployment whose proxy or storage already imposes one.
DJANGO_SUPPORT_MAX_UPLOAD_MB=10
# Empty allows any extension. A list narrows it: png,jpg,pdf
DJANGO_SUPPORT_UPLOAD_EXTENSIONS=
# Zero keeps everything. Set a window and schedule `manage.py support_prune`;
# nothing deletes a customer's support history until you run it.
DJANGO_SUPPORT_RETENTION_DAYS=0
DJANGO_SHOP_ENABLED=false
# DJANGO_SHOP_TRANSPORTS=rest,graph,grpc
DJANGO_SHOP_CURRENCY=USD
DJANGO_SHOP_REVIEW_MODERATION=true
DJANGO_SHOP_MAX_ITEM_QUANTITY=99
DJANGO_SHOP_PAGE_SIZE=24
DJANGO_SHOP_MAX_PAGE_SIZE=100
# The wallet. Naming it installs the tables that hold people's money, so a
# deployment that names it should mean it.
DJANGO_WALLET_ENABLED=true
# DJANGO_WALLET_TRANSPORTS=rest
# The only record of what the stored amounts mean. Changing it on a deployment
# that already holds money redenominates every balance in it.
DJANGO_WALLET_CURRENCY=USD
# Which rails this deployment has actually integrated -- the outer gate. An
# administrator can configure a payment method in the admin, but if its rail is
# not named here it is never published. Empty means every rail the app knows,
# including ones nothing here has integrated.
DJANGO_WALLET_METHODS=
# Whether an account's first wallet request opens one for it.
DJANGO_WALLET_AUTO_CREATE=true
# The secret each payment rail signs its confirmations with, as `code:secret`
# pairs. Settling a movement is where money becomes real, so it is the rail's
# statement and never the account's: there is no endpoint a customer can call to
# confirm their own deposit, and this is what the webhook at
# `/api/v1/wallet/hooks/{method}` is checked against. A method with no secret
# here confirms nothing and its movements wait for an operator.
# DEV ONLY -- a real deployment takes these from the processor's dashboard.
DJANGO_WALLET_WEBHOOK_SECRETS=card:dev-only-card-secret,counter:dev-only-counter-secret
# How far out of date a signed confirmation may be, in seconds.
# DJANGO_WALLET_WEBHOOK_TOLERANCE_SECONDS=300
# Reading a balance costs one checkpoint row plus every entry written since it,
# so `manage.py wallet_archive` keeps that second number small. Either trigger
# is enough: an entry old enough, or enough of them to slow a read down.
DJANGO_WALLET_ARCHIVE_AFTER_DAYS=1
DJANGO_WALLET_ARCHIVE_THRESHOLD=20
# How far below zero a wallet may go. Zero means never, which is the only safe
# default: anything else is credit you are extending, and this app does not
# collect it.
DJANGO_WALLET_OVERDRAFT_LIMIT=0
# The deployment's own bounds, on top of whatever each configured method allows.
# Zero means no bound. The withdrawal ceiling is the cheapest defence there is
# against a compromised account emptying a wallet in a single call.
DJANGO_WALLET_MIN_DEPOSIT=0
DJANGO_WALLET_MAX_DEPOSIT=0
DJANGO_WALLET_MIN_WITHDRAWAL=0
DJANGO_WALLET_MAX_WITHDRAWAL=0
DJANGO_WALLET_PAGE_SIZE=50
DJANGO_WALLET_MAX_PAGE_SIZE=200
# The two transports beside REST. These decide which doors are open, never what
# is behind them.
DJANGO_GRAPHQL_ENABLED=true
# The in-browser GraphQL editor. Left unset it follows the settings module: on
# under config.settings.development, off everywhere else, since in production it
# is an unauthenticated schema browser. Set it here only to overrule that --
# and note that setting it to false is what makes /graphql answer a browser
# with a 404, because there is then no editor to render.
# DJANGO_GRAPHQL_GRAPHIQL=true
# What one GraphQL request may cost. A REST caller is bounded by the route they
# picked; a GraphQL caller writes the query, and every one of these schemas has
# a cycle in it, so these are what stand between a short hostile document and a
# table scan per request. Zero turns one off.
DJANGO_GRAPHQL_MAX_DEPTH=10
DJANGO_GRAPHQL_MAX_ALIASES=15
DJANGO_GRAPHQL_MAX_TOKENS=2000
# Whether the schema describes itself. On by default, because a public API's
# schema is usually meant to be public and every code generator reads it. Set
# false where the API is internal and you would rather not hand somebody who
# found the endpoint a complete map of it.
DJANGO_GRAPHQL_INTROSPECTION=true
DJANGO_GRPC_ENABLED=true
DJANGO_GRPC_PORT=50051

# How often one caller may ask, whichever endpoint they are asking. ANON counts
# by IP where nothing was proved; AUTH counts by credential everywhere else, so
# an office behind one NAT does not throttle itself. LOGIN is separate and much
# tighter, for the doors that take a secret and say whether it was right: the
# per-account guess limits above cannot see a run that tries fifty thousand
# accounts once each. UPLOAD is separate because that request costs a disk.
# `<count>/<period>`, period one of s, m, h, d. Empty turns a scope off, which
# is how a deployment that rate-limits at its CDN avoids counting twice.
# The counters live in the default cache, so these are per process until that
# cache is Redis or Memcached.
DJANGO_API_THROTTLE_ANON=120/min
DJANGO_API_THROTTLE_AUTH=600/min
DJANGO_API_THROTTLE_LOGIN=60/min
DJANGO_API_THROTTLE_UPLOAD=60/hour

# Which hosts a browser may open a WebSocket from. Browsers do not apply the
# same-origin policy to WebSockets, and these sockets accept a session cookie as
# identity -- so without this any page a signed-in person visits could open
# their feed. Left empty it follows DJANGO_ALLOWED_HOSTS, which is right when
# the frontend is served by this deployment. Name your frontend's host here when
# it is not; `*` turns the check off.
DJANGO_WEBSOCKET_ALLOWED_ORIGINS=

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
