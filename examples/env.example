# The .env the example project is built with, and every app this starter ships
# turned on at once.
#
#   python examples/build.py     # copies this file in as the project's .env
#   cp examples/env.example .env # or read it into a project of your own
#
# This is the maximal configuration: four login methods, four second factors,
# four social providers, all three token modes installed with one active, and
# all three feature apps -- the CMS, notifications and the shop -- on. It is
# meant for reading and for local exploration; a real deployment names the
# handful of apps it actually wants, because an app that is not named installs
# nothing, migrates nothing and publishes no routes.
#
# Every value marked DEV ONLY has to change before anyone but you can reach the
# service. The social credentials below are placeholders shaped like the real
# thing: enough for the apps to install and for `manage.py check` to pass, and
# not enough to complete a sign-in -- that half is answered by the provider.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=example-only-secret-key                      # DEV ONLY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Login methods: password, email_code, sms_code, magic_link
# ---------------------------------------------------------------------------
DJANGO_AUTH_METHODS=password,email_code,sms_code,magic_link
DJANGO_AUTH_AUTO_CREATE_USERS=true

# Second factors: totp, sms, email, recovery. Requires a login method.
DJANGO_AUTH_SECOND_FACTORS=totp,sms,email,recovery
DJANGO_AUTH_TOTP_ISSUER=Django Ninja Starter
DJANGO_AUTH_RECOVERY_CODE_COUNT=10

# ---------------------------------------------------------------------------
# Token mode: which credential a finished login hands back.
# "all" installs the tables for every mode; DJANGO_AUTH_TOKEN_MODE picks the one
# that issues. A deployment that has settled on a mode should name just that one
# here instead, and carry only its tables.
# ---------------------------------------------------------------------------
DJANGO_OAUTH_MODE=all
DJANGO_AUTH_TOKEN_MODE=rotation
# Lets a staff member already signed into the admin have the Swagger page
# authorise itself, instead of pasting a token into it by hand. Staff-only, and
# unset it to unpublish the route altogether.
DJANGO_AUTH_SESSION_TOKEN_FOR_STAFF=true
DJANGO_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
DJANGO_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
DJANGO_AUTH_SLIDING_IDLE_TIMEOUT_SECONDS=900

# Signed credentials. HS256 works from the secret key alone; an RS*/ES*
# algorithm needs a real key pair, and the system checks insist on one.
DJANGO_AUTH_JWT_ALGORITHM=HS256
DJANGO_AUTH_JWT_SIGNING_KEY=example-only-jwt-signing-key       # DEV ONLY
DJANGO_AUTH_JWT_VERIFYING_KEY=
DJANGO_AUTH_JWT_ISSUER=django-ninja-starter
DJANGO_AUTH_JWT_AUDIENCE=
DJANGO_AUTH_JWT_LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Where codes and links go, and where the pending half of a two-step login is
# kept. The in-memory store below needs no Redis and forgets everything on
# restart -- fine for one process, wrong the moment there are two.
# ---------------------------------------------------------------------------
DJANGO_AUTH_CHALLENGE_STORE=infrastructure.auth.core.challenges.LocMemChallengeStore  # DEV ONLY
DJANGO_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_AUTH_SMS_BACKEND=infrastructure.auth.core.delivery.ConsoleSmsBackend           # DEV ONLY
DJANGO_AUTH_EMAIL_BACKEND=infrastructure.auth.core.delivery.DjangoEmailBackend
DJANGO_AUTH_EMAIL_FROM=sign-in@example.com
DJANGO_AUTH_SMS_FROM=+15555550100
DJANGO_AUTH_MAGIC_LINK_BASE_URL=http://localhost:5173/auth/link
DJANGO_AUTH_PASSWORD_RESET_BASE_URL=http://localhost:5173/auth/reset

# Challenge shape and rate limits.
DJANGO_AUTH_CHALLENGE_TTL_SECONDS=300
DJANGO_AUTH_CHALLENGE_MAX_ATTEMPTS=5
DJANGO_AUTH_PENDING_LOGIN_TTL_SECONDS=600
DJANGO_AUTH_CODE_DIGITS=6
DJANGO_AUTH_RESEND_COOLDOWN_SECONDS=30
DJANGO_AUTH_MAX_SENDS_PER_HOUR=10

# ---------------------------------------------------------------------------
# Social sign-in. Each provider needs real credentials from its own console,
# and each redirect URI must be registered there exactly as written here.
# ---------------------------------------------------------------------------
DJANGO_OAUTH_PROVIDERS=google,apple,microsoft,github
DJANGO_OAUTH_AUTO_CREATE_USERS=true
DJANGO_OAUTH_STORE_PROVIDER_TOKENS=false
DJANGO_OAUTH_ENCRYPTION_KEY=
DJANGO_OAUTH_LOGIN_REDIRECT_URL=/
DJANGO_OAUTH_STATE_TTL_SECONDS=600
DJANGO_OAUTH_CLOCK_SKEW_SECONDS=60
DJANGO_OAUTH_HTTP_TIMEOUT_SECONDS=10

GOOGLE_OAUTH_CLIENT_ID=example-google-client                   # DEV ONLY
GOOGLE_OAUTH_CLIENT_SECRET=example-google-secret               # DEV ONLY
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Apple posts its callback cross-site, so this one has to be HTTPS even locally.
APPLE_OAUTH_CLIENT_ID=example.apple.service                    # DEV ONLY
APPLE_OAUTH_TEAM_ID=EXAMPLETEAM                                # DEV ONLY
APPLE_OAUTH_KEY_ID=EXAMPLEKEY                                  # DEV ONLY
APPLE_OAUTH_PRIVATE_KEY=example-apple-private-key              # DEV ONLY
APPLE_OAUTH_REDIRECT_URI=https://example.test/api/v1/oauth/apple/callback

MICROSOFT_OAUTH_CLIENT_ID=example-microsoft-client             # DEV ONLY
MICROSOFT_OAUTH_CLIENT_SECRET=example-microsoft-secret         # DEV ONLY
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback

GITHUB_OAUTH_CLIENT_ID=example-github-client                   # DEV ONLY
GITHUB_OAUTH_CLIENT_SECRET=example-github-secret               # DEV ONLY
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback

# ---------------------------------------------------------------------------
# Content. Naming the app is what installs it: without this there are no CMS
# tables, no CMS routes and no admin for it.
# ---------------------------------------------------------------------------
DJANGO_CMS_ENABLED=true
# The languages content may be written in: the first is the default, and the one
# a missing translation falls back to.
DJANGO_CMS_LANGUAGES=en-us,fa
DJANGO_CMS_PREVIEW_TTL_SECONDS=86400
# Where a file an editor uploads on the content screen is written, inside
# whatever STORAGES["default"] is -- MEDIA_ROOT here, a bucket in production.
DJANGO_CMS_UPLOAD_PATH=cms/uploads
DJANGO_CMS_MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Notifications. Enabling this installs the tables, the read API *and* the
# WebSocket -- which `manage.py runserver` will never serve, because Django's
# development server is WSGI. Use `make serve` for the socket.
# ---------------------------------------------------------------------------
DJANGO_NOTIFICATIONS_ENABLED=true
DJANGO_NOTIFICATIONS_WS_PATH=/ws/notifications
# How a notification created in one process reaches sockets held open by
# another. MemoryBroker fans out inside a single process, which is why it needs
# nothing installed and why it is wrong the moment there are two workers -- a
# client on the first would never hear what the second created. `check` says so
# while this is still in place.
DJANGO_NOTIFICATIONS_BROKER=apps.notifications.broadcast.MemoryBroker   # DEV ONLY
DJANGO_NOTIFICATIONS_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_NOTIFICATIONS_CHANNEL_PREFIX=notifications
# How many unread notifications a reconnecting client is caught up with. The
# list endpoint holds the rest of the history.
DJANGO_NOTIFICATIONS_SOCKET_BACKLOG=20

# ---------------------------------------------------------------------------
# The shop. The third feature app, and the largest: a catalogue anybody may
# read, and a basket, an order and an invoice that are nobody's but the
# caller's. Naming it is what installs it, as with the other two.
# ---------------------------------------------------------------------------
DJANGO_SHOP_ENABLED=true
# One currency for the whole shop rather than one per product: a catalogue
# priced in several needs a conversion, a rounding and a display policy, and
# inventing those silently is worse than saying a shop has one currency.
DJANGO_SHOP_CURRENCY=USD
# Whether a review waits for a moderator before anybody else can read it. On,
# because a shop that publishes whatever arrives is a shop with spam on it.
DJANGO_SHOP_REVIEW_MODERATION=true
DJANGO_SHOP_MAX_ITEM_QUANTITY=99
DJANGO_SHOP_PAGE_SIZE=24
DJANGO_SHOP_MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Uploaded files. Django serves MEDIA_URL itself only while DEBUG is on; in
# production a web server or an object store does, and a project that points
# STORAGES at a bucket uses neither of these.
# ---------------------------------------------------------------------------
DJANGO_MEDIA_URL=media/
DJANGO_MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Accounts and production hardening.
# ---------------------------------------------------------------------------
DJANGO_ACCOUNTS_DEFAULT_LOCALE=en-us
DJANGO_ACCOUNTS_DEFAULT_TIMEZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
