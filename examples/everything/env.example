# Every app this starter ships, turned on at once.
#
#   cp examples/everything/env.example .env
#
# This is the maximal configuration: four login methods, four second factors,
# four social providers and all three token modes installed with one active. It
# is meant for reading and for local exploration -- a real deployment names the
# handful of apps it actually wants, because an app that is not named installs
# nothing, migrates nothing and publishes no routes.
#
# Lines marked DEV ONLY must change before anyone but you can reach the service.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production                      # DEV ONLY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Login methods: password, email_code, sms_code, magic_link
# ---------------------------------------------------------------------------
DJANGO_AUTH_METHODS=password,email_code,sms_code,magic_link
DJANGO_AUTH_AUTO_CREATE_USERS=true

# Second factors: totp, sms, email, recovery. Requires a login method.
DJANGO_AUTH_SECOND_FACTORS=totp,sms,email,recovery
DJANGO_AUTH_TOTP_ISSUER=Django Ninja Starter
DJANGO_AUTH_RECOVERY_CODE_COUNT=10

# ---------------------------------------------------------------------------
# Token mode: which credential a finished login hands back.
# "all" installs the tables for every mode; DJANGO_AUTH_TOKEN_MODE picks the one
# that issues. A deployment that has settled on a mode should name just that one
# here instead, and carry only its tables.
# ---------------------------------------------------------------------------
DJANGO_OAUTH_MODE=all
DJANGO_AUTH_TOKEN_MODE=rotation
DJANGO_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
DJANGO_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
DJANGO_AUTH_SLIDING_IDLE_TIMEOUT_SECONDS=900

# Signed credentials. HS256 works from the secret key alone; an RS*/ES*
# algorithm needs a real key pair, and the system checks insist on one.
DJANGO_AUTH_JWT_ALGORITHM=HS256
DJANGO_AUTH_JWT_SIGNING_KEY=change-me-too                      # DEV ONLY
DJANGO_AUTH_JWT_VERIFYING_KEY=
DJANGO_AUTH_JWT_ISSUER=django-ninja-starter
DJANGO_AUTH_JWT_AUDIENCE=
DJANGO_AUTH_JWT_LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Where codes and links go, and where the pending half of a two-step login is
# kept. The in-memory store below needs no Redis and forgets everything on
# restart -- fine for one process, wrong the moment there are two.
# ---------------------------------------------------------------------------
DJANGO_AUTH_CHALLENGE_STORE=infrastructure.auth.core.challenges.LocMemChallengeStore  # DEV ONLY
DJANGO_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_AUTH_SMS_BACKEND=infrastructure.auth.core.delivery.ConsoleSmsBackend           # DEV ONLY
DJANGO_AUTH_EMAIL_BACKEND=infrastructure.auth.core.delivery.DjangoEmailBackend
DJANGO_AUTH_EMAIL_FROM=sign-in@example.com
DJANGO_AUTH_SMS_FROM=+15555550100
DJANGO_AUTH_MAGIC_LINK_BASE_URL=http://localhost:5173/auth/link
DJANGO_AUTH_PASSWORD_RESET_BASE_URL=http://localhost:5173/auth/reset

# Challenge shape and rate limits.
DJANGO_AUTH_CHALLENGE_TTL_SECONDS=300
DJANGO_AUTH_CHALLENGE_MAX_ATTEMPTS=5
DJANGO_AUTH_PENDING_LOGIN_TTL_SECONDS=600
DJANGO_AUTH_CODE_DIGITS=6
DJANGO_AUTH_RESEND_COOLDOWN_SECONDS=30
DJANGO_AUTH_MAX_SENDS_PER_HOUR=10

# ---------------------------------------------------------------------------
# Social sign-in. Each provider needs real credentials from its own console,
# and each redirect URI must be registered there exactly as written here.
# ---------------------------------------------------------------------------
DJANGO_OAUTH_PROVIDERS=google,apple,microsoft,github
DJANGO_OAUTH_AUTO_CREATE_USERS=true
DJANGO_OAUTH_STORE_PROVIDER_TOKENS=false
DJANGO_OAUTH_ENCRYPTION_KEY=
DJANGO_OAUTH_LOGIN_REDIRECT_URL=/
DJANGO_OAUTH_STATE_TTL_SECONDS=600
DJANGO_OAUTH_CLOCK_SKEW_SECONDS=60
DJANGO_OAUTH_HTTP_TIMEOUT_SECONDS=10

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Apple posts its callback cross-site, so this one has to be HTTPS even locally.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=https://example.test/api/v1/oauth/apple/callback

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback

# ---------------------------------------------------------------------------
# Accounts and production hardening.
# ---------------------------------------------------------------------------
DJANGO_ACCOUNTS_DEFAULT_LOCALE=en-us
DJANGO_ACCOUNTS_DEFAULT_TIMEZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
