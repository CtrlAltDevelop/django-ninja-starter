DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_OAUTH_MODE=none
DJANGO_OAUTH_PROVIDERS=
DJANGO_OAUTH_ENCRYPTION_KEY=
DJANGO_OAUTH_AUTO_CREATE_USERS=true
DJANGO_OAUTH_STORE_PROVIDER_TOKENS=false
DJANGO_OAUTH_LOGIN_REDIRECT_URL=/
DJANGO_OAUTH_CLOCK_SKEW_SECONDS=60
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
DJANGO_AUTH_METHODS=
DJANGO_AUTH_SECOND_FACTORS=
DJANGO_AUTH_TOKEN_MODE=
DJANGO_AUTH_SESSION_TOKEN_FOR_STAFF=true
DJANGO_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_AUTH_CHALLENGE_STORE=infrastructure.auth.core.challenges.RedisChallengeStore
DJANGO_AUTH_CHALLENGE_TTL_SECONDS=300
DJANGO_AUTH_CHALLENGE_MAX_ATTEMPTS=5
DJANGO_AUTH_PENDING_LOGIN_TTL_SECONDS=600
DJANGO_AUTH_CODE_DIGITS=6
DJANGO_AUTH_RESEND_COOLDOWN_SECONDS=30
DJANGO_AUTH_MAX_SENDS_PER_HOUR=10
DJANGO_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
DJANGO_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
DJANGO_AUTH_SLIDING_IDLE_TIMEOUT_SECONDS=900
DJANGO_AUTH_SMS_BACKEND=infrastructure.auth.core.delivery.ConsoleSmsBackend
DJANGO_AUTH_EMAIL_BACKEND=infrastructure.auth.core.delivery.DjangoEmailBackend
DJANGO_AUTH_EMAIL_FROM=no-reply@example.com
DJANGO_AUTH_SMS_FROM=
DJANGO_AUTH_MAGIC_LINK_BASE_URL=
DJANGO_AUTH_PASSWORD_RESET_BASE_URL=
DJANGO_AUTH_AUTO_CREATE_USERS=true
DJANGO_AUTH_TOTP_ISSUER=Django Ninja Starter
DJANGO_AUTH_RECOVERY_CODE_COUNT=10
DJANGO_AUTH_JWT_ALGORITHM=HS256
DJANGO_AUTH_JWT_SIGNING_KEY=
DJANGO_AUTH_JWT_VERIFYING_KEY=
DJANGO_AUTH_JWT_ISSUER=django-ninja-starter
DJANGO_AUTH_JWT_AUDIENCE=
DJANGO_AUTH_JWT_LEEWAY_SECONDS=30
DJANGO_CMS_ENABLED=false
DJANGO_CMS_LANGUAGES=en-us
DJANGO_CMS_PREVIEW_TTL_SECONDS=86400
DJANGO_CMS_UPLOAD_PATH=cms/uploads
DJANGO_CMS_MAX_UPLOAD_MB=20
# Where uploaded files are written and the address they are served under. Both
# are unused by a project that points STORAGES at a bucket instead.
DJANGO_MEDIA_URL=media/
DJANGO_MEDIA_ROOT=
DJANGO_NOTIFICATIONS_ENABLED=false
DJANGO_NOTIFICATIONS_WS_PATH=/ws/notifications
DJANGO_NOTIFICATIONS_BROKER=apps.notifications.broadcast.MemoryBroker
DJANGO_NOTIFICATIONS_REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_NOTIFICATIONS_CHANNEL_PREFIX=notifications
DJANGO_NOTIFICATIONS_SOCKET_BACKLOG=20
# Zero keeps everything. Set a window and schedule
# `manage.py notifications_prune`; nothing deletes anything until you run it.
DJANGO_NOTIFICATIONS_RETENTION_DAYS=0
DJANGO_SHOP_ENABLED=false
DJANGO_SHOP_CURRENCY=USD
DJANGO_SHOP_REVIEW_MODERATION=true
DJANGO_SHOP_MAX_ITEM_QUANTITY=99
DJANGO_SHOP_PAGE_SIZE=24
DJANGO_SHOP_MAX_PAGE_SIZE=100
# The two transports beside REST. These decide which doors are open, never what
# is behind them.
DJANGO_GRAPHQL_ENABLED=true
# The in-browser GraphQL editor. Left unset it follows the settings module: on
# under config.settings.development, off everywhere else, since in production it
# is an unauthenticated schema browser. Set it here only to overrule that --
# and note that setting it to false is what makes /graphql answer a browser
# with a 404, because there is then no editor to render.
# DJANGO_GRAPHQL_GRAPHIQL=true
DJANGO_GRPC_ENABLED=true
DJANGO_GRPC_PORT=50051

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
